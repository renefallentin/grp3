direction: right

# ============================================================
# PHYSICAL NETWORK TOPOLOGY
#
# Purpose:
#   - Show physical devices
#   - Show physical/uplink relationships
#   - Show WAN, routed uplinks and trunks
#   - Show which endpoints attach to which access switch
#
# Logical VLAN/subnet design belongs in logical-topology.d2
# ============================================================

style.fill: "#1E2129"


# ============================================================
# CLASSES
# ============================================================

classes: {

  # ----------------------------------------------------------
  # SITE CONTAINER
  # ----------------------------------------------------------

  site: {
    style: {
      fill: "#232833"
      stroke: "#596275"
      stroke-width: 2
      stroke-dash: 3
      border-radius: 12

      font-color: "#E6E6F0"
      font-size: 14
      bold: true
    }
  }


  # ----------------------------------------------------------
  # BASE DEVICE
  # ----------------------------------------------------------

  device: {
    shape: image

    width: 64
    height: 64

    label.near: outside-bottom-center

    style: {
      font-color: "#E6E6F0"
      font-size: 12
      bold: true
    }
  }


  # ----------------------------------------------------------
  # DEVICE TYPES
  # ----------------------------------------------------------

  isp: {
    icon: ../../assets/icons/network/isp.svg

    width: 82
    height: 50
  }

  router: {
    icon: ../../assets/icons/network/routerbw.svg
  }

  switch-l3: {
    icon: ../../assets/icons/network/switchl3bw.svg
  }

  switch-l2: {
    icon: ../../assets/icons/network/switchl2bw.svg
  }

  server: {
    icon: ../../assets/icons/network/server.svg
  }

  laptop: {
    icon: ../../assets/icons/network/laptop.svg
  }

  client: {
    icon: ../../assets/icons/network/client.svg
  }


  # ==========================================================
  # CONNECTION CLASSES
  # ==========================================================

  link: {
    style: {
      stroke-width: 2
      font-size: 10
      font-color: "#D7DAE0"
      border-radius: 8
    }
  }


  # Animation is deliberately connection-only.
  flow: {
    style: {
      animated: true
    }
  }


  # Internet/WAN
  wan: {
    style: {
      stroke: "#C792EA"
      font-color: "#C792EA"

      stroke-width: 3
      stroke-dash: 4
    }
  }


  # Router <-> L3 switch
  routed: {
    style: {
      stroke: "#89DDFF"
      font-color: "#89DDFF"

      stroke-width: 3
      stroke-dash: 3
    }
  }


  # Switch <-> switch trunk
  trunk: {
    style: {
      stroke: "#FFCB6B"
      font-color: "#FFCB6B"

      stroke-width: 3
      stroke-dash: 2
    }
  }


  # Physical access port carrying VLAN 20
  access-vlan20: {
    style: {
      stroke: "#C3E88D"
      font-color: "#C3E88D"

      stroke-width: 2
    }
  }


  # Generic endpoint/access link
  access: {
    style: {
      stroke: "#BFC7D5"
      font-color: "#BFC7D5"

      stroke-width: 2
    }
  }


  # Ready for future HA/failover links
  redundant: {
    style: {
      stroke: "#F78C6C"
      font-color: "#F78C6C"

      stroke-width: 3
      stroke-dash: 6
    }
  }
}


# ============================================================
# INTERNET
# ============================================================

internet: ISP {
  class: [device; isp]

  tooltip: "Internet Service Provider"
}


# ============================================================
# DK1
# ============================================================

dk1: DK1 {
  class: site


  # ----------------------------------------------------------
  # ROUTER
  # ----------------------------------------------------------

  router: DK1-R1 {
    class: [device; router]

    tooltip: "Role: DK1 Edge Router\nSite: DK1\nManagement: 10.10.99.2\nUpstream: ISP\nDownstream: DK1-SW-L3"

    link: ../routers/dk1-r1/
  }


  # ----------------------------------------------------------
  # LAYER 3 SWITCH
  # ----------------------------------------------------------

  sw_l3: DK1-SW-L3 {
    class: [device; switch-l3]

    tooltip: "Role: DK1 Layer 3 Core Switch\nSite: DK1\nManagement: 10.10.99.2\nUpstream: DK1-R1\nDownstream: DK1-SW-L2"

    link: ../switches/dk1-sw-l3/
  }


  # ----------------------------------------------------------
  # LAYER 2 SWITCH
  # ----------------------------------------------------------

  sw_l2: DK1-SW-L2 {
    class: [device; switch-l2]

    tooltip: "Role: DK1 Layer 2 Access Switch\nSite: DK1\nManagement: 10.10.99.2\nUplink: DK1-SW-L3"

    link: ../switches/dk1-sw-l2/
  }


  # ----------------------------------------------------------
  # SERVERS
  # ----------------------------------------------------------

  server1: DK1-SRV-01 {
    class: [device; server]

    tooltip: "Role: Domain Controller\nSite: DK1\nIP: 10.10.20.10"

    link: ../servers/dk1-srv-01/
  }


  server2: DK1-SRV-02 {
    class: [device; server]

    tooltip: "Role: SCCM Server\nSite: DK1\nIP: 10.10.20.11"

    link: ../servers/dk1-srv-02/
  }


  server3: DK1-SRV-03 {
    class: [device; server]

    tooltip: "Role: SQL Database\nSite: DK1\nIP: 10.10.20.11"

    link: ../servers/dk1-srv-03/
  }


  server4: DK1-SRV-04 {
    class: [device; server]

    tooltip: "Role: Backup Server\nSite: DK1\nIP: 10.10.20.11"

    link: ../servers/dk1-srv-04/
  }


  # ==========================================================
  # PHYSICAL DK1 LINKS
  # ==========================================================

  router <-> sw_l3: Routed Uplink {
    class: [link; routed; flow]

    tooltip: "Routed physical uplink\nDK1-R1 ↔ DK1-SW-L3"
  }


  sw_l3 <-> sw_l2: 802.1Q Trunk {
    class: [link; trunk; flow]

    tooltip: "802.1Q physical trunk\nDK1-SW-L3 ↔ DK1-SW-L2\nAllowed VLANs: 10, 20, 30, 99"
  }


  sw_l2 <-> server1: Access • VLAN 20 {
    class: [link; access-vlan20]
  }

  sw_l2 <-> server2: Access • VLAN 20 {
    class: [link; access-vlan20]
  }

  sw_l2 <-> server3: Access • VLAN 20 {
    class: [link; access-vlan20]
  }

  sw_l2 <-> server4: Access • VLAN 20 {
    class: [link; access-vlan20]
  }
}


# ============================================================
# DK2
# ============================================================

dk2: DK2 {
  class: site


  # ----------------------------------------------------------
  # ROUTER
  # ----------------------------------------------------------

  router: DK2-R1 {
    class: [device; router]

    tooltip: "Role: DK2 Edge Router\nSite: DK2\nManagement: 10.10.99.2\nUpstream: ISP\nDownstream: DK2-SW-L3"

    link: ../routers/dk2-r1/
  }


  # ----------------------------------------------------------
  # LAYER 3 SWITCH
  # ----------------------------------------------------------

  sw_l3: DK2-SW-L3 {
    class: [device; switch-l3]

    tooltip: "Role: DK2 Layer 3 Core Switch\nSite: DK2\nManagement: 10.10.99.2\nUpstream: DK2-R1\nDownstream: DK2-SW-L2"

    link: ../switches/dk2-sw-l3/
  }


  # ----------------------------------------------------------
  # LAYER 2 SWITCH
  # ----------------------------------------------------------

  sw_l2: DK2-SW-L2 {
    class: [device; switch-l2]

    tooltip: "Role: DK2 Layer 2 Access Switch\nSite: DK2\nManagement: 10.10.99.2\nUplink: DK2-SW-L3"

    link: ../switches/dk2-sw-l2/
  }


  # ----------------------------------------------------------
  # SERVER
  # ----------------------------------------------------------

  server5: DK2-SRV-05 {
    class: [device; server]

    tooltip: "Role: Backup Server\nSite: DK2\nIP: 10.10.20.11"

    link: ../servers/dk2-srv-05/
  }


  # ----------------------------------------------------------
  # CLIENTS
  # ----------------------------------------------------------

  client1: Client 1 {
    class: [device; laptop]

    tooltip: "Client workstation\nSite: DK2\nIP: 10.10.20.11"

    link: ../clients/client-1/
  }


  client2: Client 2 {
    class: [device; client]

    tooltip: "Client workstation\nSite: DK2\nIP: 10.10.20.11"

    link: ../clients/client-2/
  }


  # ==========================================================
  # PHYSICAL DK2 LINKS
  # ==========================================================

  router <-> sw_l3: Routed Uplink {
    class: [link; routed; flow]

    tooltip: "Routed physical uplink\nDK2-R1 ↔ DK2-SW-L3"
  }


  sw_l3 <-> sw_l2: 802.1Q Trunk {
    class: [link; trunk; flow]

    tooltip: "802.1Q physical trunk\nDK2-SW-L3 ↔ DK2-SW-L2\nAllowed VLANs: 10, 20, 30, 99"
  }


  sw_l2 <-> server5: Access • VLAN 20 {
    class: [link; access-vlan20]
  }


  sw_l2 <-> client1 {
    class: [link; access]
  }


  sw_l2 <-> client2 {
    class: [link; access]
  }
}


# ============================================================
# WAN CONNECTIONS
# ============================================================

internet <-> dk1.router: ISP {
  class: [link; wan; flow]

  tooltip: "DK1 Internet/WAN connection"
}


internet <-> dk2.router: ISP {
  class: [link; wan; flow]

  tooltip: "DK2 Internet/WAN connection"
}


# ============================================================
# OPTIONAL FUTURE REDUNDANCY
# ============================================================

# dk1.sw_l3 <-> dk2.sw_l3: Redundant L3 {
#   class: [link; redundant; flow]
# }

# dk1.sw_l2 <-> dk2.sw_l2: Backup Trunk {
#   class: [link; redundant; flow]
# }